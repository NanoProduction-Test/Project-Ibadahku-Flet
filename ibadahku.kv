#:kivy 2.3.1

# ---------------------------------------------------------------------------
# Template dasar (dynamic class)
# ---------------------------------------------------------------------------

<Layar@MDBoxLayout>:
    orientation: "vertical"
    md_bg_color: app.warna_malam if app.theme_cls.theme_style == "Dark" else app.warna_langit

<Kartu@MDCard>:
    md_bg_color: app.warna_malam_kartu if app.theme_cls.theme_style == "Dark" else app.warna_permukaan
    radius: [18]
    elevation: 0

<Chip@MDRaisedButton>:
    elevation: 0
    theme_text_color: "Custom"
    md_bg_color: app.warna_indigo_soft if app.theme_cls.theme_style != "Dark" else app.warna_malam_kartu
    text_color: app.warna_tinta if app.theme_cls.theme_style != "Dark" else app.warna_ivory

<NavTab@MDBoxLayout>:
    orientation: "vertical"
    padding: "0dp"
    spacing: "3dp"

<Navigasi>:
    size_hint_y: None
    height: "72dp"
    padding: "0dp", "6dp"
    spacing: "0dp"
    md_bg_color: app.warna_malam_kartu if app.theme_cls.theme_style == "Dark" else app.warna_permukaan
    elevation: 4
    NavTab:
        MDBoxLayout:
            size_hint_y: None
            height: "3dp"
            padding: "20dp", "0dp"
            MDBoxLayout:
                md_bg_color: app.theme_cls.primary_color if root.layar_aktif == "home" else (0, 0, 0, 0)
        MDIconButton:
            icon: "home-variant" if root.layar_aktif == "home" else "home-outline"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primary_color if root.layar_aktif == "home" else app.theme_cls.disabled_hint_text_color
            pos_hint: {"center_x": .5}
            on_release: root.pindah("home")
        MDLabel:
            text: "Beranda"
            font_style: "Caption"
            halign: "center"
            size_hint_y: None
            height: "14dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.layar_aktif == "home" else app.theme_cls.disabled_hint_text_color
    NavTab:
        MDBoxLayout:
            size_hint_y: None
            height: "3dp"
            padding: "20dp", "0dp"
            MDBoxLayout:
                md_bg_color: app.theme_cls.primary_color if root.layar_aktif == "kegiatan" else (0, 0, 0, 0)
        MDIconButton:
            icon: "format-list-checks"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primary_color if root.layar_aktif == "kegiatan" else app.theme_cls.disabled_hint_text_color
            pos_hint: {"center_x": .5}
            on_release: root.pindah("kegiatan")
        MDLabel:
            text: "Kegiatan"
            font_style: "Caption"
            halign: "center"
            size_hint_y: None
            height: "14dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.layar_aktif == "kegiatan" else app.theme_cls.disabled_hint_text_color
    NavTab:
        MDBoxLayout:
            size_hint_y: None
            height: "3dp"
            padding: "20dp", "0dp"
            MDBoxLayout:
                md_bg_color: app.theme_cls.primary_color if root.layar_aktif == "timer" else (0, 0, 0, 0)
        MDIconButton:
            icon: "timer-outline"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primary_color if root.layar_aktif == "timer" else app.theme_cls.disabled_hint_text_color
            pos_hint: {"center_x": .5}
            on_release: root.pindah("timer")
        MDLabel:
            text: "Fokus"
            font_style: "Caption"
            halign: "center"
            size_hint_y: None
            height: "14dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.layar_aktif == "timer" else app.theme_cls.disabled_hint_text_color
    NavTab:
        MDBoxLayout:
            size_hint_y: None
            height: "3dp"
            padding: "20dp", "0dp"
            MDBoxLayout:
                md_bg_color: app.theme_cls.primary_color if root.layar_aktif == "tasbih" else (0, 0, 0, 0)
        MDIconButton:
            icon: "circle-double"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primary_color if root.layar_aktif == "tasbih" else app.theme_cls.disabled_hint_text_color
            pos_hint: {"center_x": .5}
            on_release: root.pindah("tasbih")
        MDLabel:
            text: "Tasbih"
            font_style: "Caption"
            halign: "center"
            size_hint_y: None
            height: "14dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.layar_aktif == "tasbih" else app.theme_cls.disabled_hint_text_color
    NavTab:
        MDBoxLayout:
            size_hint_y: None
            height: "3dp"
            padding: "20dp", "0dp"
            MDBoxLayout:
                md_bg_color: app.theme_cls.primary_color if root.layar_aktif == "pengaturan" else (0, 0, 0, 0)
        MDIconButton:
            icon: "cog-outline"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primary_color if root.layar_aktif == "pengaturan" else app.theme_cls.disabled_hint_text_color
            pos_hint: {"center_x": .5}
            on_release: root.pindah("pengaturan")
        MDLabel:
            text: "Atur"
            font_style: "Caption"
            halign: "center"
            size_hint_y: None
            height: "14dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.layar_aktif == "pengaturan" else app.theme_cls.disabled_hint_text_color

# ---------------------------------------------------------------------------
# Splash
# ---------------------------------------------------------------------------

<SplashScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.theme_cls.primary_dark
            Rectangle:
                pos: self.pos
                size: self.size
        SplashArt:
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
        MDBoxLayout:
            orientation: "vertical"
            pos_hint: {"center_x": .5, "center_y": .5}
            adaptive_height: True
            spacing: "10dp"
            MDLabel:
                text: "IbadahKu"
                font_style: "H3"
                theme_text_color: "Custom"
                text_color: app.warna_ivory
                halign: "center"
                bold: True
            MDLabel:
                text: "Pendamping Ibadah Harian"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: app.warna_amber
                halign: "center"

# ---------------------------------------------------------------------------
# Beranda
# ---------------------------------------------------------------------------

<HomeScreen>:
    Layar:
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "16dp", "8dp"
            md_bg_color: app.theme_cls.primary_dark
            MDLabel:
                text: "IbadahKu"
                font_style: "H5"
                bold: True
                theme_text_color: "Custom"
                text_color: app.warna_ivory
            MDBoxLayout:
                orientation: "vertical"
                MDLabel:
                    text: root.tanggal
                    font_style: "Caption"
                    halign: "right"
                    theme_text_color: "Custom"
                    text_color: app.warna_ivory
                MDLabel:
                    text: root.tanggal_hijri
                    font_style: "Caption"
                    halign: "right"
                    theme_text_color: "Custom"
                    text_color: app.warna_amber
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "16dp"
                spacing: "16dp"
                adaptive_height: True
                FloatLayout:
                    size_hint_y: None
                    height: "192dp"
                    LangitHero:
                        size_hint: 1, 1
                        pos_hint: {"x": 0, "y": 0}
                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint: 1, 1
                        padding: "20dp", "18dp"
                        spacing: "2dp"
                        MDLabel:
                            text: "Menuju waktu sholat"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.warna_amber
                            adaptive_height: True
                        MDLabel:
                            text: root.countdown
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.warna_ivory
                            adaptive_height: True
                        MDLabel:
                            text: root.ringkasan
                            font_style: "Body2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 0.85
                            adaptive_height: True
                        Widget:
                        MDLabel:
                            text: root.kutipan
                            font_style: "Caption"
                            italic: True
                            theme_text_color: "Custom"
                            text_color: app.warna_amber_soft
                            adaptive_height: True
                Kartu:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: "18dp"
                    spacing: "10dp"
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "14dp"
                        CircularProgress:
                            id: bar_progress
                            value: 0
                            size_hint: None, None
                            size: "56dp", "56dp"
                            pos_hint: {"center_y": .5}
                        MDBoxLayout:
                            orientation: "vertical"
                            pos_hint: {"center_y": .5}
                            MDLabel:
                                text: "Checklist Hari Ini"
                                font_style: "Subtitle1"
                                bold: True
                                adaptive_height: True
                            MDLabel:
                                text: root.teks_streak
                                font_style: "Caption"
                                theme_text_color: "Secondary"
                                adaptive_height: True
                        MDLabel:
                            text: root.progres_hari
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            size_hint_x: None
                            width: "58dp"
                            halign: "right"
                    MDBoxLayout:
                        id: grid_ceklis
                        orientation: "vertical"
                        adaptive_height: True
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "8dp"
                        padding: ["0dp", "4dp", "0dp", "0dp"]
                        MDFlatButton:
                            text: "+ Tambah"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            on_release: root.buka_popup_ceklis()
                        Widget:
                        MDFlatButton:
                            text: "Selesaikan"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            on_release: root.selesaikan_semua()
                        MDFlatButton:
                            text: "Reset"
                            theme_text_color: "Secondary"
                            on_release: root.reset_ceklis_hari_ini()
                Kartu:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: "18dp"
                    spacing: "4dp"
                    MDLabel:
                        text: "Jadwal Hari Ini"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True
                    MDBoxLayout:
                        id: timeline
                        orientation: "vertical"
                        adaptive_height: True
                MDBoxLayout:
                    size_hint_y: None
                    height: "84dp"
                    spacing: "12dp"
                    Kartu:
                        orientation: "vertical"
                        padding: "2dp", "8dp"
                        MDIconButton:
                            icon: "book-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            pos_hint: {"center_x": .5}
                            on_release: root.manager.current = "doa"
                        MDLabel:
                            text: "Doa"
                            font_style: "Caption"
                            bold: True
                            halign: "center"
                    Kartu:
                        orientation: "vertical"
                        padding: "2dp", "8dp"
                        MDIconButton:
                            icon: "compass-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            pos_hint: {"center_x": .5}
                            on_release: root.manager.current = "kiblat"
                        MDLabel:
                            text: "Kiblat"
                            font_style: "Caption"
                            bold: True
                            halign: "center"
                    Kartu:
                        orientation: "vertical"
                        padding: "2dp", "8dp"
                        MDIconButton:
                            icon: "chart-bar"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            pos_hint: {"center_x": .5}
                            on_release: root.manager.current = "statistik"
                        MDLabel:
                            text: "Statistik"
                            font_style: "Caption"
                            bold: True
                            halign: "center"
                Kartu:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "150dp"
                    padding: "18dp"
                    MDLabel:
                        text: "Ayat Hari Ini"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True
                    MDLabel:
                        text: root.ayat_hari
                        font_name: app.font_arab
                        font_size: "25sp"
                        halign: "right"
                        text_size: self.width, None
                        shorten: False
                    GarisHias:
                        size_hint_y: None
                        height: "10dp"
                    MDLabel:
                        text: root.arti_hari
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        italic: True
                    MDLabel:
                        text: root.surah_hari
                        font_style: "Overline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
        Navigasi:
            layar_aktif: "home"

<BarisTimeline>:
    size_hint_y: None
    height: "46dp"
    orientation: "vertical"
    padding: "0dp"
    spacing: "0dp"
    elevation: 0
    radius: [0]
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        size_hint_y: None
        height: "38dp"
        MDLabel:
            text: root.jam
            font_style: "Subtitle2"
            bold: True
            size_hint_x: 0.28
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.is_jadwal else app.warna_amber
        MDLabel:
            text: root.nama
            font_style: "Body1"
            size_hint_x: 0.72
    HairlineDivider:
        size_hint_y: None
        height: "8dp"

<BarisCeklis>:
    size_hint_y: None
    height: "58dp"
    orientation: "vertical"
    padding: "0dp"
    spacing: "0dp"
    elevation: 0
    radius: [0]
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        size_hint_y: None
        height: "50dp"
        spacing: "4dp"
        MDIconButton:
            icon: "check-circle" if root.selesai else "circle-outline"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color if root.selesai else app.theme_cls.disabled_hint_text_color
            on_release: root.on_release()
        MDLabel:
            text: root.data['nama'] if root.data else ""
            font_style: "Body1"
        MDIconButton:
            icon: "trash-can-outline"
            theme_text_color: "Hint"
            on_release: root.hapus()
    HairlineDivider:
        size_hint_y: None
        height: "8dp"

<BarisCeklisKegiatan>:
    size_hint_y: None
    height: "62dp"
    orientation: "vertical"
    padding: "0dp"
    spacing: "0dp"
    elevation: 0
    radius: [0]
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        size_hint_y: None
        height: "54dp"
        spacing: "4dp"
        MDIconButton:
            icon: "check-circle" if root.selesai else "circle-outline"
            theme_text_color: "Custom"
            text_color: app.warna_amber if root.selesai else app.theme_cls.disabled_hint_text_color
            on_release: root.on_release()
        MDBoxLayout:
            orientation: "vertical"
            MDLabel:
                text: root.data['nama'] if root.data else ""
                font_style: "Body1"
                shorten: True
            MDLabel:
                text: f"{root.data['jam']}  •  {root.data['kategori']}" if root.data else ""
                font_style: "Caption"
                theme_text_color: "Secondary"
        MDLabel:
            text: "Pribadi"
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: app.warna_amber
            size_hint_x: 0.26
            halign: "right"
    HairlineDivider:
        size_hint_y: None
        height: "8dp"

# ---------------------------------------------------------------------------
# Kegiatan
# ---------------------------------------------------------------------------

<KegiatanScreen>:
    Layar:
        MDTopAppBar:
            title: "Kegiatanku"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
            right_action_items: [["plus", lambda x: setattr(root.manager, 'current', 'tambah')]]
        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "12dp"
            MDLabel:
                text: "Atur pengingat pribadi untuk ibadah, belajar, atau rutinitas harian."
                font_style: "Caption"
                theme_text_color: "Secondary"
                adaptive_height: True
            MDScrollView:
                Kartu:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "6dp", "4dp"
                    id: daftar_kegiatan
        Navigasi:
            layar_aktif: "kegiatan"

<BarisKegiatan>:
    size_hint_y: None
    height: "70dp"
    orientation: "vertical"
    padding: "0dp"
    spacing: "0dp"
    elevation: 0
    radius: [0]
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        size_hint_y: None
        height: "62dp"
        MDBoxLayout:
            orientation: "vertical"
            padding: "10dp", "6dp"
            MDLabel:
                text: root.data['nama'] if root.data else ""
                font_style: "Subtitle1"
                bold: True
            MDLabel:
                text: f"{root.data['jam']}  •  {root.data['hari']}  •  {root.data['kategori']}" if root.data else ""
                font_style: "Caption"
                theme_text_color: "Secondary"
        MDIconButton:
            icon: "trash-can-outline"
            theme_text_color: "Hint"
            pos_hint: {"center_y": .5}
            on_release: root.hapus()
    HairlineDivider:
        size_hint_y: None
        height: "8dp"

<TambahScreen>:
    Layar:
        MDTopAppBar:
            title: "Tambah Kegiatan"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
            left_action_items: [["arrow-left", lambda x: setattr(root.manager, 'current', 'kegiatan')]]
        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "16dp"
            MDTextField:
                id: inp_nama
                hint_text: "Nama Kegiatan"
                helper_text: "Contoh: Baca Qur'an 1 halaman"
                helper_text_mode: "on_focus"
                icon_right: "pencil"
            MDTextField:
                id: inp_jam
                hint_text: "Jam (24 Jam)"
                helper_text: "Format: HH:MM, misal 06:30"
                helper_text_mode: "on_focus"
                icon_right: "clock-outline"
            MDBoxLayout:
                adaptive_height: True
                spacing: "16dp"
                Chip:
                    id: btn_hari
                    text: "Setiap hari"
                    size_hint_x: 1
                    on_release: root.menu_hari.open()
                Chip:
                    id: btn_kategori
                    text: "Ibadah"
                    size_hint_x: 1
                    on_release: root.menu_kategori.open()
            MDLabel:
                id: lbl_pesan
                text: ""
                theme_text_color: "Error"
                font_style: "Caption"
                adaptive_height: True
            Widget:
            MDBoxLayout:
                adaptive_height: True
                spacing: "16dp"
                MDFlatButton:
                    text: "BATAL"
                    size_hint_x: 1
                    on_release: root.manager.current = "kegiatan"
                MDRaisedButton:
                    text: "SIMPAN"
                    size_hint_x: 1
                    on_release: root.simpan()

# ---------------------------------------------------------------------------
# Timer
# ---------------------------------------------------------------------------

<TimerScreen>:
    Layar:
        MDTopAppBar:
            title: "Timer Ibadah"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "20dp"
            MDLabel:
                text: "Sediakan waktu tenang untuk ibadah, tilawah, atau belajar."
                font_style: "Caption"
                theme_text_color: "Secondary"
                halign: "center"
                adaptive_height: True
            AnchorLayout:
                size_hint_y: None
                height: "300dp"
                anchor_x: "center"
                anchor_y: "center"
                FloatLayout:
                    size_hint: None, None
                    size: min(dp(250), self.parent.width - dp(16)), min(dp(250), self.parent.height - dp(16))
                    CircularProgress:
                        id: progres
                        value: root.progress
                        size_hint: None, None
                        size: min(dp(230), self.parent.width), min(dp(230), self.parent.height)
                        pos_hint: {"center_x": .5, "center_y": .5}
                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint: None, None
                        size: min(dp(190), self.parent.width - dp(20)), "92dp"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: "2dp"
                        MDLabel:
                            text: root.waktu
                            font_style: "H3"
                            bold: True
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                        MDLabel:
                            text: root.status
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            shorten: True
            MDBoxLayout:
                adaptive_height: True
                spacing: "12dp"
                MDLabel:
                    text: "Durasi (menit):"
                    adaptive_width: True
                    pos_hint: {"center_y": .5}
                Chip:
                    id: btn_durasi
                    text: "15 menit"
                    on_release: root.menu.open()
            MDBoxLayout:
                adaptive_height: True
                spacing: "12dp"
                MDRaisedButton:
                    text: "Mulai"
                    size_hint_x: 1
                    on_release: root.mulai()
                MDFlatButton:
                    text: "Jeda"
                    size_hint_x: 1
                    on_release: root.jeda()
                MDFlatButton:
                    text: "Ulang"
                    size_hint_x: 1
                    on_release: root.ulang()
            MDLabel:
                text: root.total_hari_ini
                font_style: "Caption"
                theme_text_color: "Secondary"
                halign: "center"
                adaptive_height: True
        Navigasi:
            layar_aktif: "timer"

# ---------------------------------------------------------------------------
# Tasbih
# ---------------------------------------------------------------------------

<TasbihScreen>:
    Layar:
        MDTopAppBar:
            title: "Tasbih Digital"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "16dp"
            Kartu:
                orientation: "horizontal"
                size_hint_y: None
                height: "54dp"
                padding: "4dp"
                Chip:
                    id: btn_dzikir
                    text: "Subhanallah"
                    elevation: 0
                    md_bg_color: 0, 0, 0, 0
                    on_release: root.menu_dzikir.open()
                Widget:
                    size_hint_x: None
                    width: "1dp"
                    canvas:
                        Color:
                            rgba: (1, 1, 1, 0.12) if app.theme_cls.theme_style == "Dark" else (0, 0, 0, 0.10)
                        Rectangle:
                            pos: self.pos
                            size: self.size
                Chip:
                    id: btn_target
                    text: "33"
                    size_hint_x: 0.55
                    elevation: 0
                    md_bg_color: 0, 0, 0, 0
                    on_release: root.menu_target.open()
            AnchorLayout:
                size_hint_y: None
                height: "300dp"
                anchor_x: "center"
                anchor_y: "center"
                TasbihCircleButton:
                    id: tasbih_button
                    hitungan: root.hitungan
                    target_teks: root.ids.btn_target.text
                    size_hint: None, None
                    size: min(dp(250), self.parent.width - dp(32)), min(dp(250), self.parent.height - dp(32))

            MDLabel:
                text: root.progres_label
                font_style: "Subtitle1"
                bold: True
                halign: "center"
                adaptive_height: True
            MDFlatButton:
                text: "Reset Hitungan Hari Ini"
                theme_text_color: "Secondary"
                pos_hint: {"center_x": .5}
                on_release: root.ulang()
        Navigasi:
            layar_aktif: "tasbih"

# ---------------------------------------------------------------------------
# Doa
# ---------------------------------------------------------------------------

<DoaScreen>:
    Layar:
        MDTopAppBar:
            title: "Doa"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
            left_action_items: [["arrow-left", lambda x: setattr(root.manager, 'current', 'home')]]
            right_action_items: [[root.tombol_favorit, lambda x: root.toggle_favorit()]]
        MDLabel:
            text: root.nomor
            font_style: "Caption"
            theme_text_color: "Secondary"
            halign: "center"
            size_hint_y: None
            height: "24dp"
        MDScrollView:
            Kartu:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: "24dp"
                spacing: "14dp"
                margin: "16dp"
                MDLabel:
                    text: root.judul
                    font_style: "H6"
                    bold: True
                    halign: "center"
                    adaptive_height: True
                MDLabel:
                    text: root.arab
                    font_name: app.font_arab
                    font_size: "32sp"
                    halign: "right"
                    valign: "middle"
                    text_size: self.width, None
                    shorten: False
                    adaptive_height: True
                GarisHias:
                    size_hint_y: None
                    height: "12dp"
                MDLabel:
                    text: root.latin
                    font_style: "Body2"
                    theme_text_color: "Secondary"
                    italic: True
                    halign: "center"
                    adaptive_height: True
                MDLabel:
                    text: root.arti
                    font_style: "Body1"
                    halign: "center"
                    adaptive_height: True
        MDBoxLayout:
            adaptive_height: True
            padding: "16dp"
            spacing: "16dp"
            MDFlatButton:
                text: "SEBELUMNYA"
                theme_text_color: "Secondary"
                on_release: root.sebelumnya()
            Widget:
            MDRaisedButton:
                text: "ACAK"
                on_release: root.acak()
            Widget:
            MDFlatButton:
                text: "BERIKUTNYA"
                theme_text_color: "Secondary"
                on_release: root.berikutnya()

# ---------------------------------------------------------------------------
# Kiblat
# ---------------------------------------------------------------------------

<KiblatScreen>:
    Layar:
        MDTopAppBar:
            title: "Arah Kiblat"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
            left_action_items: [["arrow-left", lambda x: setattr(root.manager, 'current', 'home')]]
        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "16dp"
            MDLabel:
                text: root.info
                font_style: "Caption"
                theme_text_color: "Secondary"
                halign: "center"
                adaptive_height: True
            MDLabel:
                text: root.derajat
                font_style: "H3"
                theme_text_color: "Custom"
                text_color: app.warna_amber
                bold: True
                halign: "center"
                adaptive_height: True
            FloatLayout:
                KompasKiblat:
                    id: kompas
                    size_hint: None, None
                    size: "270dp", "270dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
            MDLabel:
                text: root.keterangan
                font_style: "Body2"
                theme_text_color: "Secondary"
                halign: "center"
                adaptive_height: True

<BadgeCard>:
    size_hint_y: None
    height: "104dp"
    padding: "10dp"
    orientation: "vertical"
    radius: [14]
    elevation: 0
    md_bg_color: app.warna_amber_soft if root.unlocked else (app.warna_malam_kartu if app.theme_cls.theme_style == "Dark" else app.warna_langit_dim)
    MDLabel:
        text: root.nama
        font_style: "Subtitle2"
        bold: True
        halign: "center"
        theme_text_color: "Custom"
        text_color: app.warna_tinta if root.unlocked else app.theme_cls.disabled_hint_text_color
    MDLabel:
        text: root.deskripsi
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: app.warna_tinta if root.unlocked else app.theme_cls.disabled_hint_text_color

# ---------------------------------------------------------------------------
# Statistik
# ---------------------------------------------------------------------------

<StatistikScreen>:
    Layar:
        MDTopAppBar:
            title: "Statistik"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
            left_action_items: [["arrow-left", lambda x: setattr(root.manager, 'current', 'home')]]
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "16dp"
                spacing: "16dp"
                adaptive_height: True
                MDLabel:
                    text: "Ringkasan"
                    font_style: "H6"
                    bold: True
                    adaptive_height: True
                MDBoxLayout:
                    id: grid_stat
                    orientation: "vertical"
                    spacing: "8dp"
                    adaptive_height: True
                MDLabel:
                    text: "Aktivitas 7 Hari Terakhir"
                    font_style: "H6"
                    bold: True
                    adaptive_height: True
                Kartu:
                    size_hint_y: None
                    height: "150dp"
                    padding: "16dp"
                    WeeklyChart:
                        id: weekly_chart
                MDLabel:
                    text: "Pencapaian"
                    font_style: "H6"
                    bold: True
                    adaptive_height: True
                MDGridLayout:
                    id: badge_grid
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True

# ---------------------------------------------------------------------------
# Pengaturan
# ---------------------------------------------------------------------------

<PengaturanScreen>:
    Layar:
        MDTopAppBar:
            title: "Pengaturan"
            elevation: 0
            md_bg_color: app.theme_cls.primary_dark
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "16dp"
                spacing: "16dp"
                adaptive_height: True
                Kartu:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    adaptive_height: True
                    MDLabel:
                        text: "Pengingat"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True
                    MDBoxLayout:
                        adaptive_height: True
                        MDLabel:
                            text: "Alarm sholat & kegiatan"
                            font_style: "Body2"
                        MDSwitch:
                            id: sw_alarm
                            on_active: root.ubah_alarm(self, self.active)
                    MDBoxLayout:
                        adaptive_height: True
                        MDLabel:
                            text: "Ingatkan sebelum (menit)"
                            font_style: "Body2"
                        Chip:
                            id: btn_alarm_menit
                            text: "10"
                            on_release: root.menu_alarm.open()
                Kartu:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    adaptive_height: True
                    MDLabel:
                        text: "Lokasi"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True
                    MDFlatButton:
                        text: "Deteksi lokasi otomatis"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        on_release: root.deteksi_lokasi()
                    MDLabel:
                        id: lbl_lokasi
                        text: ""
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "12dp"
                        Chip:
                            id: btn_kota
                            text: "Jakarta"
                            size_hint_x: 1
                            on_release: root.menu_kota.open()
                Kartu:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    adaptive_height: True
                    MDLabel:
                        text: "Tema"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True
                    MDBoxLayout:
                        adaptive_height: True
                        MDLabel:
                            text: "Mode Gelap"
                            font_style: "Body2"
                        MDSwitch:
                            id: sw_gelap
                            on_active: root.ubah_mode(self, self.active)
                    MDLabel:
                        text: "Warna Utama"
                        font_style: "Body2"
                        adaptive_height: True
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "8dp"
                        MDIconButton:
                            icon: "circle"
                            theme_text_color: "Custom"
                            text_color: 0.180, 0.165, 0.361, 1
                            on_release: root.ubah_warna("Indigo")
                        MDIconButton:
                            icon: "circle"
                            theme_text_color: "Custom"
                            text_color: 0.404, 0.227, 0.718, 1
                            on_release: root.ubah_warna("DeepPurple")
                        MDIconButton:
                            icon: "circle"
                            theme_text_color: "Custom"
                            text_color: 0.376, 0.490, 0.545, 1
                            on_release: root.ubah_warna("BlueGray")
                        MDIconButton:
                            icon: "circle"
                            theme_text_color: "Custom"
                            text_color: 0.475, 0.333, 0.282, 1
                            on_release: root.ubah_warna("Brown")
                    MDLabel:
                        id: lbl_status
                        text: ""
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        adaptive_height: True
        Navigasi:
            layar_aktif: "pengaturan"
